<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Directives</title>
    <style>
        table {
          font-family: arial, sans-serif;
          border-collapse: collapse;
        }

        td, th {
          border: 1px solid #dddddd;
          text-align: left;
          padding: 8px;
        }

        tr:nth-child(even) {
          background-color: #dddddd;
        }
    </style>
</head>
<body>
    <h1>Directives</h1>
    {% if is_super_admin %}
        <a href="/manage_users">Manage users</a>
    {% endif %}
    <a href="/audit_log">Audit log</a>
    <a href="/change_password">Change account password</a>
    <form action="/add_directive" method="post">
        <label>
            Directive type
            <select name="directive_type" id="directive_type">
                <option value="removed_notice">removed notice</option>
                <option value="removed_notice_note">removed notice (with author note)</option>
                <option value="do_not_serve">do not serve</option>
                <option value="no_restrictions">no restrictions</option>
            </select>
        </label>
        <br>
        <label>
            Website
            <select name="website" id="website">
                <option value="archiveofourown.org">archiveofourown.org</option>
                <option value="www.fanfiction.net">www.fanfiction.net</option>
                <option value="xenforo.com">xenforo.com</option>
            </select>
        </label>
        <br>
        Selector type:
        <label>
            <input type="radio" name="selector_type" value="author">
            Author
        </label>
        <label>
            <input type="radio" name="selector_type" value="pseud">
            Pseud
        </label>
        <label>
            <input type="radio" name="selector_type" value="work_id">
            Work id
        </label>
        <br>
        <label>
            Selector
            <input type="text" name="selector">
        </label>
        <label>
            Directive data
            <input type="text" name="directive_data">
        </label>
        <br>
        <label>
            Origin
            <input type="text" name="origin" value="*">
        </label>
        <br>
        <label>
            Note:<br>
            <textarea name="change_note" id="change_note" cols="50" rows="4"></textarea>
        </label>
        <br>
        <input type="submit" value="Submit">
    </form>
    <h3>Current directives:</h3>
    <form action="/directives" method="get">
        <label>
            Search directives
            <input type="text" name="search_term">
        </label>
        <input type="submit" value="Submit">
    </form>
    {% if is_search %}
        <a href="/directives">Clear search</a>
    {% endif %}
    <table>
        <tr>
            <th>Directive ID</th>
            <th>Website</th>
            <th>Selector type</th>
            <th>Selector</th>
            <th>Directive type</th>
            <th>Directive data</th>
            <th>Applies to</th>
            <th>Enabled</th>
        </tr>
        {% for directive in directives %}
            <tr>
                <td><a href="/directives/{{ directive.id_ }}">{{ directive.id_ }}</a></td>
                <td>{{ directive.website }}</td>
                <td>{{ directive.selector_type }}</td>
                <td>{{ directive.selector }}</td>
                <td>{{ directive.directive_type }}</td>
                <td>{{ directive.directive_data }}</td>
                <td>{{ directive.applies_to }}</td>
                <td>
                    <label>
                        <input type="checkbox" disabled {{ "checked" if directive.active }}>
                    </label>
                </td>
            </tr>
        {% endfor %}
    </table>
    {% if not is_search %}
        {% if page != 1 %}
            <a href="?page={{ page - 1 }}">Last page</a>
        {% endif %}
        {% if next_page %}
            <a href="?page={{ page + 1 }}">Next page</a>
        {% endif %}
    {% endif %}

</body>
</html>