<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>ao3saver secret removal form</title>
    <style>
        table {
          font-family: arial, sans-serif;
          border-collapse: collapse;
        }

        td, th {
          border: 1px solid #dddddd;
          text-align: left;
          padding: 8px;
        }

        tr:nth-child(even) {
          background-color: #dddddd;
        }
    </style>
</head>
<body>
    <h1>Modify directives</h1>
    <form action="/add_directive" method="post">
        <label>
            Directive type
            <select name="directive_type" id="directive_type">
                <option value="removed_notice">removed notice</option>
                <option value="removed_notice_note">removed notice (with author note)</option>
                <option value="do_not_serve">do not serve</option>
            </select>
        </label>
        <br>
        Selector type:
        <label>
            <input type="radio" name="selector_type" value="author">
            Author
        </label>
        <label>
            <input type="radio" name="selector_type" value="work_id">
            Work id
        </label>
        <br>
        <label>
            Selector
            <input type="text" name="selector">
        </label>
        <label>
            Directive data
            <input type="text" name="directive_data">
        </label>
        <br>
        <label>
            Note:<br>
            <textarea name="change_note" id="change_note" cols="50" rows="4"></textarea>
        </label>
        <br>
        <input type="submit" value="Submit">
    </form>
    <h3>Current directives:</h3>
    <table>
        <tr>
            <th>Directive ID</th>
            <th>Selector</th>
            <th>Directive type</th>
            <th>Directive data</th>
        </tr>
        {% for directive in directives %}
            <tr>
                <td>{{ directive.id_ }}</td>
                <td>{{ directive.selector }}</td>
                <td>{{ directive.directive_type }}</td>
                <td>{{ directive.directive_data }}</td>
                <td>
                    <form action="/remove_directive" method="post">
                        <button name="directive_id" value="{{ directive.id_ }}">Delete</button>
                    </form>
                </td>
            </tr>
        {% endfor %}
    </table>

</body>
</html>